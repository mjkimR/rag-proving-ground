# Copy this file to .env and customize the keys for your workspace.
#
#   cp .env.example .env
#

# ------------------------------------------------------------------------------
# 1. API Keys & LLM Provider Keys (Optional: fill in if models.yaml uses them)
# ------------------------------------------------------------------------------
VLLM_API_KEY=...
OPENAI_API_KEY=sk-...

# ------------------------------------------------------------------------------
# 2. LiteLLM Settings (Gateway & Default Models)
# ------------------------------------------------------------------------------
# LangChain clients use the LiteLLM gateway as an OpenAI-compatible endpoint.
LITELLM_BASE_URL=http://localhost:4000/v1
LITELLM_API_KEY=sk-local
LITELLM_TEMPERATURE=0.0
LITELLM_MAX_RETRIES=2
LITELLM_TIMEOUT=60.0

# LiteLLM Routing Default Models
LITELLM_DEFAULT_LLM_MODEL=gpt-oss-20b
LITELLM_DEFAULT_EMBEDDING_MODEL=vllm-embedding
LITELLM_DEFAULT_RERANKER_MODEL=vllm-reranker

# ------------------------------------------------------------------------------
# 3. File Storage Settings (MinIO / S3 or Local Filesystem)
# ------------------------------------------------------------------------------
# Choose the file storage provider: s3 | local | none
FS_PROVIDER=s3

# S3 / MinIO Storage Configuration (Active when FS_PROVIDER=s3)
FS_S3_ENDPOINT_URL=http://localhost:9000
FS_S3_ACCESS_KEY=minioadmin
FS_S3_SECRET_KEY=minioadmin
FS_S3_BUCKET_NAME=my-bucket
FS_S3_REGION_NAME=
FS_S3_AUTO_CREATE_BUCKET=true

# Local Filesystem Storage Configuration (Active when FS_PROVIDER=local)
FS_LOCAL_BUCKET_NAME=local_storage

# ------------------------------------------------------------------------------
# 4. Document Parser Settings (Docling Only)
# ------------------------------------------------------------------------------
# Active parser provider (only "docling" is currently supported)
PARSER_PROVIDER=docling

# Docling Serve Endpoint Configuration
DOCLING_BASE_URL=http://127.0.0.1:5001
DOCLING_TIMEOUT=120.0

# ------------------------------------------------------------------------------
# 5. Global HTTP Client Settings (Httpx)
# ------------------------------------------------------------------------------
HTTP_TIMEOUT=5.0
HTTP_MAX_CONNECTIONS=100
HTTP_MAX_KEEPALIVE_CONNECTIONS=20
HTTP_KEEPALIVE_EXPIRY=5.0

# ------------------------------------------------------------------------------
# 6. Frontend App Settings (Vite React Client)
# ------------------------------------------------------------------------------
VITE_API_BASE_URL=http://localhost:8389
VITE_COPILOT_RUNTIME_URL=http://localhost:8389/api/v1/copilot
# VITE_OFFICE_CONVERT_URL=