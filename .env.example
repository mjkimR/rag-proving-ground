# Copy this file to .env and fill in the keys used by models.yaml.
#
# cp .env.example .env
# scripts/litellm_proxy.sh

OPENAI_API_KEY=sk-...
LOCAL_API_KEY=...

# LangChain clients use the LiteLLM gateway as an OpenAI-compatible endpoint.
LITELLM_BASE_URL=http://localhost:4000/v1
LITELLM_API_KEY=sk-local
LITELLM_DEFAULT_LLM_MODEL=gpt-oss-20b
LITELLM_DEFAULT_EMBEDDING_MODEL=vllm-embedding
LITELLM_DEFAULT_RERANKER_MODEL=vllm-reranker

# Optional overrides used by scripts/litellm_proxy.sh
# LITELLM_PORT=4000
# CONFIG_FILE=/absolute/path/to/models.yaml
# ENV_FILE=/absolute/path/to/.env
# FORCE_PORT_KILL=1
